{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "road-rush1",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-19",
  "durable_objects": {
    "bindings": [
      { "name": "RACE_ROOMS", "class_name": "RaceRoom" },\n      { "name": "LEADERBOARD", "class_name": "LeaderboardStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaceRoom"] },\n    { "tag": "v2", "new_sqlite_classes": ["LeaderboardStore"] }
  ]
}
